# ============================================================================ #
# PodFlow - Git Ignore Rules (merge-conflict markers removed)                  #
# ============================================================================ #

# 1. Build output and compiled binaries
/build/
*.o
*.obj
*.d
*.a
*.so
*.out
*.exe
/server
/client
/test_protocol
/test_ring_buffer
/test_session
/pacing_experiment

# 2. Generated media (create locally with: bash media/generate_wav.sh)
*.wav
!media/generate_wav.sh

# 3. Debugging, sanitizers, valgrind, core dumps, logs
core
core.*
vgcore.*
*.log
callgrind.out.*
massif.out.*

# 4. Packet captures (force-add the final ones: git add -f captures/x.pcapng)
*.pcap
*.pcapng

# 5. Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# 6. Editor and OS artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# NOTE: results/ (csv + png) is intentionally NOT ignored: it is committed.