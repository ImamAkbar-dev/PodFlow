# Compiled binaries and object files
*.o
*.a
*.so
server
client
tests/test_protocol
tests/test_ring_buffer
tests/test_session
tests/pacing_experiment

# Generated audio files (too large for Git; generate locally via media/generate_wav.sh)
media/*.wav
!media/.gitkeep

# Raw packet captures (too large for Git; keep instructions only)
captures/*.pcap
captures/*.pcapng
!captures/README_captures.md
!captures/.gitkeep

# Temporary test outputs
/tmp/*
*.log
*.tmp
out*.wav

# Keep results CSVs and PNG plots tracked in Git
!results/
!results/*.csv
!results/*.png
!results/.gitkeep

# Editor directories
.vscode/
.idea/
__pycache__/
*.pyc