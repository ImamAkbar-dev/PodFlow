# ============================================================================ #
# PodFlow - Git ignore rules                                                   #
# ============================================================================ #

# Build output (anchored with "/": src/server and src/client are NOT ignored)
/build/
*.o
*.d
*.a
*.so
/server
/client
/server_stub
/test_protocol
/test_ring_buffer
/test_session
/pacing_experiment
/test_media_tmp/

# Generated audio files (too large for Git; generate with media/generate_wav.sh)
media/*.wav
!media/.gitkeep

# Raw packet captures (too large for Git; keep instructions only)
captures/*.pcap
captures/*.pcapng
!captures/README_captures.md
!captures/.gitkeep

# Core dumps, logs, temporary outputs
core
core.*
vgcore.*
*.log
*.tmp
out*.wav

# results/ (csv, json, png) is committed on purpose: nothing to ignore there

# Python
__pycache__/
*.pyc
.pytest_cache/

# Editors
.vscode/
.idea/
*.swp
*~